{
  "name": "texttemplate",
  "displayName": "TextTemplate",
  "publisher": "texttemplate",
  "description": "Language support and diagnostics for TextTemplate templates.",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": ["onLanguage:texttemplate"],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "texttemplate",
        "aliases": ["TextTemplate", "texttemplate"],
        "extensions": [".template"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "texttemplate",
        "scopeName": "source.texttemplate",
        "path": "./syntaxes/texttemplate.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run compile:server && npm run check-types && npm run lint && node esbuild.js",
    "compile:server": "dotnet publish ../../src/TextTemplate.LanguageServer/TextTemplate.LanguageServer.csproj --configuration Release --output server/dist -p:UseAppHost=false",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run compile:server && npm run check-types && npm run lint && node esbuild.js --production",
    "package:vsix": "vsce package --allow-missing-repository --skip-license",
    "test:server": "npm run compile:server && node tests/language-server-smoke.mjs",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "1.90.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.6.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
