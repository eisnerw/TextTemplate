  {
    "name": "none",
    "script": "{items.Where(no):[{name}]}",
    "data": {
      "items": [
        {
          "name": "dog",
          "yes": true
        },
        {
          "name": "cat",
          "yes": false
        },
        {
          "name": "zebra",
          "yes": true
        }
      ]
    },
    "expected": ""
