{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Generated (Debug)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Generated/GeneratedTemplates.csproj",
        "--configuration",
        "Debug",
        "--nologo"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "TextTemplate: Generate",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project", "src/TextTemplate.Compiler",
        "--",
        "--root", "reference",
        "--output", "Generated"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "TextTemplate: Build generated project",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "Generated/GeneratedTemplates.csproj",
        "--configuration", "Debug",
        "--nologo"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "TextTemplate: Generate",
      "dependsOrder": "sequence",
      "problemMatcher": "$msCompile"
    }    
  ]
}
