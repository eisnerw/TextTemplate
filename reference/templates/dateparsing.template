Compact timestamp: {compact.ToDate('YYYY-MM-DD HH:mm:ss','GMT')}
Ordinal timestamp: {ordinal.ToDate('YYYY-MM-DD HH:mm:ss','GMT')}
Week timestamp: {week.ToDate('YYYY-MM-DD HH:mm:ss','GMT')}
